# URL của HospitalManagement Backend (NestJS)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Chỉ dùng phía server (Route Handlers/BFF), không bundle vào JavaScript trình duyệt.
BACKEND_INTERNAL_URL="http://localhost:3000"
STAFF_ACCESS_COOKIE_MAX_AGE_SECONDS=900
STAFF_REFRESH_COOKIE_MAX_AGE_SECONDS=604800

# URL WebSocket (RealtimeGateway) — thường trùng API_URL vì Socket.IO tự
# attach vào cùng HTTP server của backend
NEXT_PUBLIC_WS_URL="http://localhost:3000"
