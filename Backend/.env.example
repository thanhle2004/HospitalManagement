# Connection string cho MySQL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/hospital_management"

# Docker Compose uses a separate URL because the MySQL hostname is `mysql`.
MYSQL_ROOT_PASSWORD="replace-with-a-random-local-root-password"
MYSQL_DATABASE="hospital_management"
MYSQL_USER="hospital"
MYSQL_PASSWORD="replace-with-a-random-local-app-password"
DATABASE_URL_DOCKER="mysql://hospital:URL_ENCODED_PASSWORD@mysql:3306/hospital_management"

PORT=3000

# Allowlist origin web, phân tách bằng dấu phẩy. Không dùng wildcard (*).
CORS_ORIGINS="http://localhost:3001"

# Mặc định bật ở development, tắt ở production. Chỉ bật production khi có
# kiểm soát truy cập ở reverse proxy/VPN.
SWAGGER_ENABLED=true

# Đổi 2 secret này khi deploy thật — dùng chuỗi random dài, KHÔNG commit giá trị thật lên git
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Dùng khi chạy `npm run prisma:seed` để tạo tài khoản Admin đầu tiên (tuỳ chọn, có default)
SEED_ADMIN_EMAIL="admin@hospital.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# JWT riêng cho Patient — KHÁC secret với Staff (đổi khi deploy thật)
JWT_PATIENT_ACCESS_SECRET="change-me-patient-access-secret"
JWT_PATIENT_ACCESS_EXPIRES_IN="30m"

JWT_PATIENT_REFRESH_SECRET="change-me-patient-refresh-secret"
JWT_PATIENT_REFRESH_EXPIRES_IN="30d"

# OTP
OTP_LENGTH=6
OTP_EXPIRES_IN_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Rate limit cho các endpoint đăng nhập/OTP/refresh. Giữ bật ở mọi môi trường.
# Bản Slice 1 dùng bộ đếm trong tiến trình; trước khi scale nhiều replica cần
# chuyển sang kho dùng chung (Redis/database-compatible store).
AUTH_RATE_LIMIT_ENABLED=true

# Routing Engine
ROUTING_QR_EXPIRES_IN_SECONDS=1800
ROUTING_MAX_RETRY_ATTEMPTS=5

# JWT riêng cho Device (Android quét QR) — chỉ có access token, không có refresh
JWT_DEVICE_ACCESS_SECRET="change-me-device-access-secret"
JWT_DEVICE_ACCESS_EXPIRES_IN="12h"
